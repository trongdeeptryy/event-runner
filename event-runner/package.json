{
  "name": "event-runner",
  "version": "3.0.0",
  "description": "Phần mềm điều khiển sự kiện chuyên nghiệp: Nhạc + Màn LED + VJ 3 tầng + Overlays vMix + Stage Display + Đèn Beat DMX Art-Net/sACN + OSC/MIDI",
  "main": "main.js",
  "author": "Event Runner Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/logic.test.js tests/protocols.test.js",
    "check": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):e.name.endsWith('.js')?[path.join(d,e.name)]:[]);const files=['main.js','preload.js',...walk('src'),...walk('tests')];files.forEach(f=>cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'}));console.log('Syntax OK ('+files.length+' files)');\"",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.eventrunner.showcontrol",
    "productName": "EVENT RUNNER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "control.html",
      "output.html",
      "stage.html",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "EventRunner-Portable-${version}.exe"
    }
  }
}
